    {
      "parameters": {
        "jsCode": "// The API's answer to the failed step (the step is also recorded on the application, and notified)\nconst item = $input.first().json;\nconst e = item.error !== undefined ? item.error : item;\nlet detail = typeof e === 'string' ? e : (e.description || e.message || JSON.stringify(e));\nlet code = Number((e && typeof e === 'object' && (e.httpCode || e.status || e.statusCode)) || 0);\nconst m = String(detail).match(/^(\\d{3}) - ([\\s\\S]*)$/);\nif (m) { code = code || Number(m[1]); detail = m[2]; }\ntry { const parsed = JSON.parse(detail); if (parsed && parsed.detail) detail = parsed.detail; } catch (err) { /* plain text */ }\nif (!code || code < 400) code = 502;\nreturn [{ json: { statusCode: code, detail: String(detail).slice(0, 600) } }];"
      },
      "id": "5aa3aeeb-60bc-525f-b5c2-95fa5a5ee1c4",
      "name": "Why it failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -260
