# ==============================================================================
# AI Recruitment Automation - Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate.
# ==============================================================================

# Application Configuration
APP_NAME=AI-Recruitment-Automation
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Storage & Ingestion Security
UPLOAD_DIR=./data/raw/cvs
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,docx,png,jpg,jpeg

# Relational Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitment_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_db

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=candidate_knowledge
QDRANT_API_KEY=

# Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384

# LLM Layer Configuration
# Options: mock, openai, huggingface
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Optional Reranking (e.g. Cohere)
COHERE_API_KEY=
RERANKING_MODEL=rerank-english-v3.0

# Observability (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-recruitment-automation

# Frontend Configuration
BACKEND_API_URL=http://localhost:8000
