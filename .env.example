# ==============================================================================
# AI Recruitment Automation - Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate.
# ==============================================================================

# Application Configuration
APP_NAME=AI-Recruitment-Automation
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Storage & Ingestion Security
UPLOAD_DIR=./data/raw/cvs
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,docx,png,jpg,jpeg

# Relational Database (PostgreSQL)
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitment_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/recruitment_db

# Vector Database (Qdrant)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=candidate_knowledge
QDRANT_API_KEY=
# Leave empty to use the Docker server above. ":memory:" or a folder path = embedded Qdrant (no Docker).
QDRANT_LOCATION=

# Embedding Model Configuration (Architecture: BAAI/bge-m3)
EMBEDDING_MODEL=BAAI/bge-m3
# cpu (works everywhere) or cuda (NVIDIA GPU, fp16). Also used by the reranker.
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024

# LLM Layer Configuration (Architecture: Qwen2.5 and Qwen2.5-VL, run in Python by Hugging Face Transformers)
# The models run on Kaggle's free GPUs (scripts/kaggle_run.py), not on our computers, so keep "mock" here
# (fixed fake answers). "huggingface" would load Qwen on this machine (7B: ~15 GB of GPU memory).
LLM_PROVIDER=mock
# To use Qwen from the app: run notebooks/kaggle/model_server.ipynb on Kaggle, then set
# LLM_PROVIDER=remote and paste the two lines it prints (they change at every Kaggle session)
REMOTE_LLM_URL=
REMOTE_LLM_TOKEN=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
MULTIMODAL_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# auto (GPU if there is one), cuda or cpu; the Kaggle jobs set cuda. LLM_DTYPE auto = float16 on GPU.
LLM_DEVICE=auto
LLM_DTYPE=auto
# Largest CV page image given to the vision model, in pixels (more = slower)
VLM_MAX_PIXELS=1003520

# Reranking (Architecture: BAAI/bge-reranker-v2-m3, runs locally)
COHERE_API_KEY=
RERANKING_MODEL=BAAI/bge-reranker-v2-m3

# Observability (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-recruitment-automation

# Frontend Configuration
BACKEND_API_URL=http://localhost:8000
